# ============ SITAS 环境变量模板 ============
# 使用：复制本文件为 .env，并填入真实值。.env 不入库。

# DeepSeek API（在 https://platform.deepseek.com 申请 key）
DEEPSEEK_API_KEY=sk-在这里填入你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 应用
DEBUG=true
# 上传目录（默认 data/uploads）
# UPLOAD_DIR=

# 数据库（默认 sqlite:///data/sitas.db）
# DATABASE_URL=sqlite:///./data/sitas.db
